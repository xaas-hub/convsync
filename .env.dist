# Copy to .env and adjust.

# Image to run. Override to test a locally built one, e.g. IMAGE=convsync:local
#IMAGE=frugan/convsync:latest

# Leave commented if the Docker daemon runs with userns-remap: the container
# stays root and is mapped to your host user. Otherwise set your own ids, or
# everything written to ./data will belong to root.
#DOCKER_USER=1000:1000

# Tesseract languages, joined with "+". Each one needs its language pack in the
# image: see TESSERACT_LANGS in the Dockerfile.
#OCR_LANGS=ita+eng
